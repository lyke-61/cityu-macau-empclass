<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  模板文件：不要直接复制到 ~/Library/LaunchAgents。
  用 scripts/install_launchd.sh 安装，它会自动把下面两个占位符替换成本机实际路径。

    __PROJECT_DIR__  本仓库的绝对路径
    __HOME__         当前用户的家目录
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>mo.cityu.empclass</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/local_run.sh</string>
    </array>

    <!-- 每 8 小时检查一次。睡眠期间计时器暂停，唤醒后 launchd 会补跑。
         数据没变化时不会写文件、不会提交。 -->
    <key>StartInterval</key>
    <integer>28800</integer>

    <!-- 登录后立刻跑一次 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.emp-class/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.emp-class/stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
