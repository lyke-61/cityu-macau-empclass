<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>mo.cityu.empclass</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/revol/dsh chat/emp-class/scripts/local_run.sh</string>
    </array>

    <!-- 每天 07:00 跑一次（页面给的是当天整表，抓一次够用一天） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 开机/登录后立刻跑一次 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/revol/.emp-class/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/revol/.emp-class/stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/revol/dsh chat/emp-class</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
