<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>mo.cityu.empclass</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/revol/dsh chat/emp-class/scripts/local_run.sh</string>
    </array>

    <!-- 每小时检查一次。睡眠期间计时器暂停，唤醒后 launchd 会补跑，
         所以合盖再打开后也会更新。数据没变化时不会写文件、不会提交。 -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- 开机/登录后立刻跑一次 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/revol/.emp-class/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/revol/.emp-class/stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/revol/dsh chat/emp-class</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
